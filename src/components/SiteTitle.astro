---
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---
<a class="oc-brand" href={siteTitleHref} aria-label={`${siteTitle} home`}>
  <img class="oc-crown" src="/brand/crown.webp" width="216" height="178" alt="" />
  <img class="oc-wordmark" src="/brand/wordmark.webp" width="462" height="88" alt="" />
  <span class="sr-only" translate="no">{siteTitle}</span>
</a>
<style>
  .oc-brand { display: inline-flex; align-items: center; gap: .4rem; padding: .25rem .5rem; max-width: 100%; width: fit-content; background: #000; border: 1px solid #71532e; border-radius: .5rem; text-decoration: none; }
  .oc-crown { width: 2.4rem; height: 2rem; object-fit: contain; }
  .oc-wordmark { width: 10rem; height: auto; min-width: 0; }
  @media (max-width: 24rem) { .oc-wordmark { width: 7.5rem; } .oc-crown { width: 1.9rem; height: 1.75rem; } }
</style>
